# liklo 配置示例：复制成 .env 或直接 export 这些变量
# 页面上的「服务配置」卡片写入 data/settings.json，优先级高于这里。

# ---------- 服务端口 ----------
LIKLO_PORT=3200
LIKLO_PUBLIC_PORT=3210
LIKLO_PUBLIC_HOST=0.0.0.0
LIKLO_SITE_DIR=liklo-site
LIKLO_SITE_PORT=3120
LIKLO_SITE_AUTO=1

# ---------- 外部工具 ----------
# 留空则找 runtime/yt-dlp.exe、runtime/ffmpeg.exe、runtime/ffprobe.exe
LIKLO_YTDLP=
LIKLO_FFMPEG=
LIKLO_FFPROBE=
# B站 cookie jar；页面导入的 jar 存到 data/cookies.txt 并自动生效
LIKLO_COOKIE=

# ---------- ASR（OpenAI 兼容的语音识别服务） ----------
ASR_BASE=http://127.0.0.1:8000/v1
ASR_API_KEY=
ASR_MODEL=MOSS-Transcribe-Diarize-q5
ASR_TIMEOUT_MS=2400000
ASR_MAX_RETRIES=3

# ---------- 本地 LLM ----------
LLM_BASE=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=600000
LLM_MAX_CONTEXT=0

# ---------- 流水线 ----------
MAX_SEGMENT_SECONDS=300
LIKLO_MULTI_P=first
MONITOR_INTERVAL_MS=600000
MONITOR_LIMIT=3
MONITOR_MAX_SEASONS=6
MIN_REPLAY_SECONDS=1200

# ---------- 数据目录 ----------
LIKLO_DATA=data
LIKLO_SETTINGS=data/settings.json
